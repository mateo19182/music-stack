# Replace placeholders with your AirVPN WireGuard settings.
# FIREWALL_VPN_INPUT_PORTS must match soulseek.listen_port in slskd.yml.
FIREWALL_VPN_INPUT_PORTS=50000
WIREGUARD_MTU=1320
WIREGUARD_PRIVATE_KEY=CHANGE_ME_WIREGUARD_PRIVATE_KEY
WIREGUARD_PRESHARED_KEY=CHANGE_ME_WIREGUARD_PRESHARED_KEY
WIREGUARD_ADDRESSES=CHANGE_ME_WIREGUARD_ADDRESSES
SERVER_COUNTRIES=Netherlands
