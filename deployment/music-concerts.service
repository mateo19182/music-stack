[Unit]
Description=Concert alerts for music-stack library artists
After=network-online.target
Wants=network-online.target
# Crashes, timeouts and failed runs alert through Telegram instead of only the journal.
OnFailure=music-concerts-failure.service

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Installed with: uv tool install git+https://github.com/mateo19182/concert-alerts@v0.1.0
ExecStart=%h/.local/bin/concert-alerts --config %h/services/music-stack/config/concerts/config.json sync
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# Dry-run by default. Add --send only after reviewing a real event report.

